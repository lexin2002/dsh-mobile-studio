<?xml version="1.0" encoding="utf-8"?>
<!--
  实时取景扫码页：全屏黑色 Camera1 预览 + 白色取景框 + 关闭按钮。
  全部原生 View，不依赖 AndroidX；相机权限由 MainActivity 在进入前申请。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <SurfaceView
        android:id="@+id/scanPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/scanFrame"
        android:layout_width="224dp"
        android:layout_height="224dp"
        android:layout_gravity="center"
        android:background="@drawable/scan_frame" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/scanClose"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="44dp"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:background="@android:color/transparent"
            android:text="‹ 关闭"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="扫码连接"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 占位，让标题真正居中 -->
        <View
            android:layout_width="44dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/scanHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="42dp"
        android:lineSpacingExtra="4dp"
        android:text="将电脑端「扫码打开」的二维码放入框内\n识别到 DSH 连接地址后会自动进入工作台"
        android:textColor="#E6FFFFFF"
        android:textSize="13sp" />
</FrameLayout>
